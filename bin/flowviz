#!/usr/bin/env python3
"""flowviz — the one path worth remembering. Bare, it prints the whole workflow."""
import os
import sys

BIN = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(BIN)
COMMANDS = ('new', 'build', 'audit', 'serve', 'captures', 'fold', 'results', 'relabel')


def version():
    try:
        return open(os.path.join(ROOT, 'VERSION')).read().strip()
    except OSError:
        return '?'


SHEET = r'''FLOW_VIZ {v} — reports and drawings an agent hands back to one human
  entry doc ~/Projects/FLOW_VIZ/AGENTS.md (read only that) · the standard SPEC.md

  F=~/Projects/FLOW_VIZ/bin/flowviz

  REPORT   a claim, the shape of the argument, evidence, a checklist the human runs and pastes into
    1  $F new report "<claim with a verb>" --dir <work folder> --rows 4 --steps 5
    2  write every slot. Keep the scaffold's ids: rows a, b, c...; a step is its row's letter + number
       (b1, b2 ... bn), never a word, never two letters. Order steps as the work must run: a snapshot,
       backup or other prerequisite goes above the write it serves, never after it.
    3  $F build <dir>/<NAME>.src.html
    4  $F audit --browser <dir>/<NAME>.html     fix every OVER and FAIL; split, never raise a cap
    5  parse-check every command yourself: bash -n · python3 -m py_compile · Parser::ParseFile
    6  $F serve <dir> --open                    hand over served; from Finder nothing reaches disk
    7  $F captures <dir>/<NAME>.html            what they pasted, per step, every note, every step they
                                                added (+ b3a, in place) and every to-do
    8  $F fold <dir>/<NAME>.src.html            steps they added, into the source under the same ids;
                                                write what fold leaves, rebuild, audit (--todo t2: a to-do too)
    9  $F results <dir>/<NAME>.src.html         once they have run it: a Results section on top (outcome,
                                                a diagram marking where it passed or failed, summary, next,
                                                a gated archive step); write it, rebuild, audit, hand back

  DRAWING  a whole system, or one segment of it, in motion
    1  $F new drawing "<claim with a verb>" --dir <work folder> --boxes 8 --flows 2
    2  write the spec (boxes on the grid, connections, flows of one-sentence steps) and the depth
    3  then build · audit --browser · serve · captures, exactly as above

  CAPS
    report   title <=70 chars with a verb · verdict <=50 words · so what <=30 · vitals <=5 · next <=4
             (<=14 words, tagged read-only|write) · exactly 1 spine diagram · rows <=6 (summary <=14)
             under <=3 section headers (<=4 words) · every row has a data-kind · open at load <=1
             · step = one sentence <=20 words · words at rest <=350 · screens <=3
    kinds    context finding record (read) · investigation test change rollback (action) · decision
    results  above the card · outcome pass|fail|blocked|inconclusive · claim <=70 with a verb · summary
             <=50 words · 1 drawing marking "result": pass|fail|error · next 1-4 · 1 gated archive step
    drawing  title <=70 with a verb · lede <=30 · boxes <=12 (<=9 as a report spine) · zones <=4
             · flows 0-3 (0 unless a walkthrough is asked for) · steps <=9, one sentence <=20
             · label <=16 chars · peek <=25 words
             · facts <=3 · connection label <=16 · words on canvas <=60 · crossings 0 · screens <=2

  PASTE-SAFE COMMANDS   no leading comment · ASCII only · nothing spans a line break · no blank lines
                        anchor every verdict literal: \bFull\b, never Full
                        a value an earlier step printed: data-emit="VER=VERSION ([0-9.]+)" on its textarea,
                        {{{{b1.VER}}}} in the later command (copy refuses until it resolves) · never PASTE_...
  AGENTS   one can do it all; shared out, each step goes to the cheapest agent that gets it right first time
    Opus, or equivalent    Lead: decides what it says (claim, rows, steps, their order and pass conditions,
                           boxes and zones), judges what was pasted, decides Results. Supervisor: a run that
                           stops behaving (traceback, 3rd rebuild still failing, sidecar missing when served)
    Sonnet, or equivalent  Builder: new, fill every slot, anchor regexes, place boxes, fold, relabel; fix
                           every OVER/FAIL that leaves the meaning unchanged; the rest goes up to the Lead
    Haiku, or equivalent   Runner: build, audit --browser, parse checks, serve, captures, screenshots,
                           relayed verbatim; decides nothing, never runs the human's steps
  STATE    <doc>.flow.json beside the html; images they attach in <doc>.assets/, named by sha256.
           A verdict they set by hand (✎) sits beside the derived one: report it as theirs.
           Ids are join keys: never rename one after handover.
           A step the human adds after b3 is b3a (then b3b); to-dos are t1, t2. Neither moves another id.
           $F relabel <NAME>.src.html moves an older report onto a / b1 naming, pasted state included.
  EXAMPLES ~/Projects/FLOW_VIZ/PLAN.html (a report with a drawing spine)
           ~/Projects/FLOW_VIZ/examples/checkout/checkout.html (a drawing with 3 flows and a segment)
           ~/Projects/FLOW_VIZ/examples/deploy/DEPLOY.html (a report after its run, with a carried value)
'''


def main():
    args = sys.argv[1:]
    if not args or args[0] in ('-h', '--help', 'help'):
        print(SHEET.format(v=version()), end='')
        return
    if args[0] in ('-V', '--version', 'version'):
        print(version())
        return
    cmd = args[0]
    if cmd not in COMMANDS:
        print('flowviz: unknown command "%s". Commands: %s. Run bare for the cheat sheet.'
              % (cmd, ', '.join(COMMANDS)), file=sys.stderr)
        sys.exit(2)
    script = os.path.join(BIN, 'flowviz-%s.py' % cmd)
    if not os.path.exists(script):
        print('flowviz: %s is missing' % script, file=sys.stderr)
        sys.exit(2)
    os.execv(sys.executable, [sys.executable, script] + args[1:])


if __name__ == '__main__':
    main()
